#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define MO_TOG(layer) &mo_tog layer layer

/ {
    combos {
        compatible = "zmk,combos";
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };
    };
};

/ {

   // Activate ADJUST layer by pressing raise and lower
    // conditional_layers {
    //     compatible = "zmk,conditional-layers";
    //     adjust_layer {
    //         if-layers = <LOWER RAISE>;
    //         then-layer = <ADJUST>;
    //     };
    // };

    behaviors {
        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            bindings = <
&kp GRAVE     &kp N1 &kp N2    &kp N3   &kp N4    &kp N5                               &kp N6    &kp N7    &kp N8    &kp N9    &kp N0   &kp BSPC
&kp TAB       &kp Q  &kp W     &kp E    &kp R     &kp T                                &kp Y     &kp U     &kp I     &kp O     &kp P    &kp RETURN
&mt LCTRL ESC &kp A  &kp S     &kp D    &kp F     &kp G                                &kp H     &kp J     &kp K     &kp L     &kp SEMI &kp SQT
&sk LSHFT     &kp Z  &kp X     &kp C    &kp V     &kp B      &kp C_MUTE      &none     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH &sk RSHFT
                     &sk LSHFT &kp LALT MO_TOG(1) &kp LGUI   &mt LSHIFT BSPC  &kp SPACE &kp RGUI  MO_TOG(2) MO_TOG(ADJUST)  &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        lower_layer {
            display-name = "fun+num";
            bindings = <
&none &none &kp F10 &kp F11 &kp F12 &none                   &none     &kp PRCNT  &kp FSLH  &kp STAR  &kp RETURN  &trans
&none &none &kp F7  &kp F8  &kp F9  &kp PRCNT               &kp EQUAL &kp N7 &kp N8 &kp N9 &kp MINUS  &trans 
&none &none &kp F4  &kp F5  &kp F6  &kp MINUS               &kp PLUS  &kp N4 &kp N5 &kp N6 &kp N0 &none
&none &none &kp F1  &kp F2  &kp F3  &kp FSLH  &trans &trans &kp STAR  &kp N1 &kp N2 &kp N3  &kp PLUS  &none
            &trans  &trans  &trans  &trans    &trans &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        raise_layer {
            display-name = "symbol";
            bindings = <
&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4               &none     &none     &none     &none    &none   &trans
&none &kp GRAVE    &kp LT       &kp GT       &kp MINUS    &kp PIPE                   &kp CARET &kp LBRC  &kp RBRC  &kp DLLR &none   &trans 
&none &kp EXCL     &kp STAR     &kp FSLH     &kp EQUAL    &kp AMPS                   &kp NUHS  &kp LPAR  &kp RPAR  &kp SEMI &kp DQT &none
&none &kp TILDE    &kp PLUS     &kp LBKT     &kp RBKT     &kp PRCNT    &trans &trans &kp AT    &kp COLON &kp COMMA &kp DOT  &kp SQT &none
                   &trans       &trans       &trans       &trans       &trans &trans &trans  &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        adjust_layer {
            display-name = "shortcuts";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4               &none  &none  &none  &none  &none &trans
&ext_power EP_TOG &none         &none         &none        &kp LG(RBKT) &kp LA(RBKT)               &none  &none  &none  &none  &none &trans
&none             &none         &kp LG(LS(S)) &none        &kp LG(LBKT) &kp LA(LBKT)               &none  &none  &none  &none  &none &none
&none             &none         &kp LG(LS(C)) &none        &none        &none        &none  &none  &none  &none  &none  &none  &none &none 
                                &trans        &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans
            >;
        };

    };
};
